# Copy to .env for local overrides. Do not commit .env.
FLASK_APP=app
FLASK_DEBUG=1

# Required for secure sessions — set a random value locally.
SECRET_KEY=replace-with-a-long-random-string

# Demo admin (plaintext only used at startup to seed the hash).
ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=changeme

# Optional: supply a precomputed Werkzeug hash instead of DEMO_ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=

# Optional: override SQLite path (default: instance/monitoring.db).
# DATABASE=
